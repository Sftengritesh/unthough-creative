# Server
PORT=5000

# MongoDB Atlas connection string
# Get this from Atlas > Connect > Drivers, replace <username>/<password>/<dbname>
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-url>/unthought-creative?retryWrites=true&w=majority

# Secret used to sign admin JWT tokens - use a long random string in production
JWT_SECRET=replace_this_with_a_long_random_secret

# Comma-separated list of allowed frontend origins for CORS
CLIENT_URL=http://localhost:5173,https://unthoughtcreative.vercel.app
